{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noti-bridge",
  "version": "0.0.1",
  "identifier": "com.notibridge.mac",
  "build": { "frontendDist": "../../shared/desktop-ui/dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "noti-bridge", "width": 460, "height": 680, "minWidth": 360, "minHeight": 480 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
